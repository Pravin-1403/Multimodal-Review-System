# VeriSight AI — Environment Variables

# ── AI Provider (configure ONE of the following) ──────────────────────────

# Google Gemini (recommended — free tier available)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT-4o Vision
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude Vision
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Usage ─────────────────────────────────────────────────────────────────
# Copy this file to .env, fill in ONE key, and run:
#   source .env && streamlit run app.py
#
# Or use Streamlit secrets: create .streamlit/secrets.toml and add:
#   GEMINI_API_KEY = "your_key"
